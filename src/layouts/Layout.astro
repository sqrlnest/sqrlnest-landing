---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CircuitBackground from "../components/CircuitBackground.astro";
import { getLocale, localizePath, stripLocale, locales, defaultLocale } from "../i18n";
import { getStrings } from "../i18n/strings";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
}

const locale = getLocale(Astro.url.pathname);
const t = getStrings(locale);

// Markdown pages (terms, privacy, roadmap, about, …) use this file as their
// `layout:` frontmatter, so Astro passes their frontmatter under a
// `frontmatter` prop (NOT as top-level props). The home page renders <Layout>
// directly and passes title/description as top-level props instead. Merge both
// shapes so per-page SEO (title/description/image) works for markdown pages —
// otherwise every markdown page would fall back to the site-wide defaults and
// share one title/description (bad for SEO).
const fm = (Astro.props.frontmatter ?? {}) as {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
};

const {
  title = fm.title ?? t.seo.title,
  description = fm.description ?? t.seo.description,
  image = fm.image ?? "/og-default.png",
  lang = fm.lang ?? locale,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Locale alternates for this page. The logical (locale-independent) path pairs
// each page with its equivalent in every other locale, used for:
//  - hreflang alternate links (lets search engines serve the right language),
//  - the footer language switcher (stay on the SAME page when switching, e.g.
//    /about/ -> /vi/about/, instead of always jumping to the home page).
const logicalPath = stripLocale(Astro.url.pathname);
const localeAlternates = locales.map((l) => ({
  locale: l,
  // BCP47-ish region hints for og:locale.
  ogLocale: l === "vi" ? "vi_VN" : "en_US",
  href: new URL(localizePath(logicalPath, l), Astro.site).toString(),
}));
// x-default points at the default-locale version of this page.
const xDefaultHref = new URL(
  localizePath(logicalPath, defaultLocale),
  Astro.site,
).toString();
const currentOgLocale = locale === "vi" ? "vi_VN" : "en_US";

// Structured data (JSON-LD). Organization + WebSite describe the brand and site
// to search engines (name, logo, URL), improving the odds of rich results /
// knowledge-panel attribution. Emitted once per page in the head.
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://ratas.ai";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: "Ratas",
      url: `${siteOrigin}/`,
      logo: `${siteOrigin}/icon-512.png`,
      description: t.seo.description,
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      name: "Ratas",
      url: `${siteOrigin}/`,
      publisher: { "@id": `${siteOrigin}/#organization` },
      inLanguage: locales.map((l) => (l === "vi" ? "vi-VN" : "en-US")),
    },
  ],
};

// Markdown pages get the `.markdown` typography wrapper; the home layout stays
// untouched. Detect them by the presence of the `frontmatter` prop.
const isMarkdown = "frontmatter" in Astro.props;

// Astro passes a `headings` array ({ depth, slug, text }) for markdown pages.
// Build a table of contents from the section headings (h2/h3; skip the single
// page-title h1). Only show a TOC when there are enough sections to warrant it.
const headings = (Astro.props.headings ?? []) as {
  depth: number;
  slug: string;
  text: string;
}[];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = isMarkdown && toc.length >= 3;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Client-side routing (View Transitions): internal navigation, including
         language switch (/ <-> /vi), swaps the DOM instead of a full reload. -->
    <ClientRouter />

    <!-- Anti-FOUC (mode): set Astryx data-theme on <html> before paint.
         "system" → no attribute (Astryx :root color-scheme follows OS).
         Re-applied after each View Transitions swap, since <head> inline
         scripts only run on the initial load. -->
    <script is:inline>
      (function () {
        function applyMode() {
          var m = localStorage.getItem("sqrlnest-mode") || "system";
          if (m === "light" || m === "dark") {
            document.documentElement.setAttribute("data-theme", m);
          } else {
            document.documentElement.removeAttribute("data-theme");
          }
        }
        applyMode();
        // ClientRouter swaps <html>/<body>; re-apply theme + mode afterwards so
        // the active theme survives language (or any) navigation.
        document.addEventListener("astro:after-swap", function () {
          applyMode();
          var th = localStorage.getItem("sqrlnest-theme") || "paper";
          document.body.setAttribute("data-astryx-theme", th);
        });
      })();
    </script>

    <!-- Shared browser store (window.__sqrlnest), consumed by the landing and
         the embedded chatbot. The inline script above handles anti-FOUC before
         paint; this module creates the TanStack-backed store and keeps prefs +
         DOM in sync. Re-run on after-swap reconciles lang with the new URL. -->
    <script>
      import { initSqrlnestStore } from "../lib/sqrlnest-store";
      import { navigate } from "astro:transitions/client";
      import { stripLocale, localizePath } from "../i18n";

      // The landing owns language navigation (URL + SEO). Inject the real
      // navigator + localizer so __sqrlnest.setLang works from anywhere
      // (including the chatbot) without importing Astro internals there.
      const init = {
        navigate,
        localizeCurrentPath: (lang) =>
          localizePath(stripLocale(location.pathname), lang),
      };
      initSqrlnestStore(init);
      document.addEventListener("astro:after-swap", () => initSqrlnestStore(init));
    </script>

    <!-- Preserve scroll position on language switch. ClientRouter scrolls to
         the top on navigation (correct for most links), but switching language
         is the SAME page in another locale, so jumping to the top feels like a
         reload. Detect "same page, different locale" (pathnames match after
         stripping the locale prefix) and restore the scroll position. -->
    <script is:inline>
      (function () {
        var LOCALES = ["vi"]; // non-default locale prefixes
        function strip(path) {
          var parts = path.split("/").filter(Boolean);
          if (parts.length && LOCALES.indexOf(parts[0]) !== -1) parts.shift();
          return "/" + parts.join("/");
        }
        var savedScroll = null;
        document.addEventListener("astro:before-preparation", function (e) {
          var from = strip(location.pathname);
          var to = strip(new URL(e.to).pathname);
          savedScroll = from === to ? window.scrollY : null;
        });
        document.addEventListener("astro:after-swap", function () {
          if (savedScroll !== null) {
            window.scrollTo({ left: 0, top: savedScroll, behavior: "instant" });
            savedScroll = null;
          }
        });
      })();
    </script>

    <!-- Fonts (Astryx sets font-family only; we load the files) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Preload the hero poster on the home page — it's the LCP element, so
        fetching it early (as an image, high priority) shortens LCP. Only on the
        home layout; markdown pages don't show it. */}
    {!isMarkdown && (
      <link
        rel="preload"
        as="image"
        href="/video/tree-poster.webp"
        fetchpriority="high"
      />
    )}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&family=Saira+Semi+Condensed:wght@300;400;500;600;700&family=Inter:wght@300..700&family=JetBrains+Mono:wght@400;500;700&family=Bitter:wght@400;500;600;700&display=swap"
    />

    <!-- Theme token sets (all 4 loaded once; scoped by [data-astryx-theme], switched at runtime) -->
    <link rel="stylesheet" href="/themes/paper.css" />
    <link rel="stylesheet" href="/themes/cyber.css" />
    <link rel="stylesheet" href="/themes/folio.css" />
    <link rel="stylesheet" href="/themes/sand.css" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Icons + PWA manifest -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#E0531A" />

    <!-- hreflang alternates: pair this page with its equivalent in each locale
         so search engines serve the right language and avoid duplicate-content
         penalties across en/vi. x-default -> the default-locale version. -->
    {
      localeAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- OpenGraph (Facebook, LinkedIn, Slack...) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Ratas" />
    <meta property="og:locale" content={currentOgLocale} />
    {
      localeAlternates
        .filter((alt) => alt.locale !== locale)
        .map((alt) => (
          <meta property="og:locale:alternate" content={alt.ogLocale} />
        ))
    }

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Structured data: Organization + WebSite -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body data-astryx-theme="paper" class="min-h-screen flex flex-col">
    <!-- Anti-FOUC (theme): set the active Astryx theme on <body> before paint. -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("sqrlnest-theme") || "paper";
        document.body.setAttribute("data-astryx-theme", t);
      })();
    </script>
    <CircuitBackground />
    <!-- Skip link: lets keyboard / screen-reader users jump straight to the
         main content, past the nav. Visually hidden until focused. -->
    <a href="#main-content" class="skip-link">Skip to content</a>
    <!-- NAV (shared across all pages) -->
    <nav
      aria-label="Primary"
      class="sticky top-0 z-50 h-14 flex items-center gap-6 px-6 sm:px-8 bg-surface/95 backdrop-blur border-b border-line"
    >
      <a href={localizePath("/", locale)} class="flex items-center gap-2 no-underline">
        {/* <span class="text-brand">🐿️</span> */}
        <img src="/logo.png" alt="Ratas" width="36" height="36" class="h-9 w-9" />
        <span class="font-sans font-bold text-sm uppercase tracking-wider text-primary">ratas</span>
      </a>
      <div class="ml-auto hidden md:flex gap-6 font-sans text-[11px] uppercase tracking-wider">
        <a href={localizePath("/#platform", locale)} class="text-secondary hover:text-brand no-underline">/platform</a>
        <a href={localizePath("/#agents", locale)} class="text-secondary hover:text-brand no-underline">/agents</a>
        <a href={localizePath("/#pricing", locale)} class="text-secondary hover:text-brand no-underline">/pricing</a>
        <a href={localizePath("/roadmap", locale)} class="text-secondary hover:text-brand no-underline">/roadmap</a>
      </div>
    </nav>
    <div class="flex-1 flex flex-col">
      {
        isMarkdown ? (
          showToc ? (
            <main id="main-content" class="mx-auto w-full max-w-5xl px-6 sm:px-8 py-12 sm:py-16 flex flex-col lg:flex-row lg:gap-12">
              <article class="markdown min-w-0 w-full max-w-3xl mx-auto lg:mx-0 flex-1">
                <slot />
              </article>
              <aside class="hidden lg:block w-56 shrink-0">
                <nav class="toc sticky top-24" aria-label="Table of contents">
                  <p class="font-sans text-[11px] uppercase tracking-wider text-secondary/70 mb-3">
                    On this page
                  </p>
                  <ul class="flex flex-col gap-1">
                    {toc.map((h) => (
                      <li class:list={[h.depth === 3 && "pl-3"]}>
                        <a href={`#${h.slug}`} class="toc-link">
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </aside>
            </main>
          ) : (
            <main id="main-content">
              <article class="markdown max-w-3xl w-full mx-auto px-6 sm:px-8 py-12 sm:py-16">
                <slot />
              </article>
            </main>
          )
        ) : (
          <slot />
        )
      }
    </div>
    <footer class="relative z-10 border-t border-line bg-surface/60">
      <div
        class="max-w-5xl mx-auto px-6 sm:px-8 py-12 grid gap-10 sm:grid-cols-2 md:grid-cols-5"
      >
        <!-- brand -->
        <div class="md:col-span-2 flex flex-col gap-3">
          <a href="/" class="flex items-center gap-2 no-underline w-fit">
            {/* <span class="text-brand text-lg">🐿️</span> */}
            <img src="/logo.png" alt="Ratas" width="40" height="40" class="h-10 w-10" />
            <span class="font-sans font-bold text-sm uppercase tracking-wider text-primary"
              >ratas</span
            >
          </a>
          <p class="text-secondary text-sm max-w-xs leading-relaxed">
            {t.footer.tagline}
          </p>
        </div>

        <!-- product links — localized to the current page's locale -->
        <nav class="flex flex-col gap-2" aria-label={t.footer.product}>
          <p class="font-sans text-[11px] uppercase tracking-wider text-secondary/70 mb-1">
            {t.footer.product}
          </p>
          <a href={localizePath("/#platform", locale)} class="footer-link">Platform</a>
          <a href={localizePath("/#agents", locale)} class="footer-link">Agents</a>
          <a href={localizePath("/#pricing", locale)} class="footer-link">Pricing</a>
          <a href={localizePath("/roadmap", locale)} class="footer-link">Roadmap</a>
        </nav>

        <!-- company links — localized -->
        <nav class="flex flex-col gap-2" aria-label={t.footer.company}>
          <p class="font-sans text-[11px] uppercase tracking-wider text-secondary/70 mb-1">
            {t.footer.company}
          </p>
          <a href={localizePath("/about", locale)} class="footer-link">About</a>
          <a href={localizePath("/responsible-ai", locale)} class="footer-link">Responsible AI</a>
          <a href={localizePath("/terms", locale)} class="footer-link">Terms</a>
          <a href={localizePath("/privacy", locale)} class="footer-link">Privacy</a>
        </nav>

        <!-- language links — switch locale but STAY on the current page, so
             /about/ -> /vi/about/ (not the home page). Built from the logical
             path so every page pairs with its equivalent in the other locale. -->
        <nav class="flex flex-col gap-2" aria-label={t.footer.language}>
          <p class="font-sans text-[11px] uppercase tracking-wider text-secondary/70 mb-1">
            {t.footer.language}
          </p>
          <a href={localizePath(logicalPath, "en")} class="footer-link">English</a>
          <a href={localizePath(logicalPath, "vi")} class="footer-link">Tiếng Việt</a>
        </nav>
      </div>

      <!-- bottom bar -->
      <div class="border-t border-line">
        <div
          class="max-w-5xl mx-auto px-6 sm:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3"
        >
          <p class="font-mono text-[11px] text-secondary">
            © {new Date().getFullYear()} Ratas. All rights reserved.
          </p>
          <p class="font-mono text-[11px] text-secondary">
            <span aria-hidden="true">🐿️</span> Powered by <span class="text-brand">Cloudflare</span>
          </p>
        </div>
      </div>
    </footer>

    <!-- TOC scroll-spy: highlight the table-of-contents entry for the section
         currently in view. Re-initialised on every navigation via
         astro:page-load (inline module scripts only run on first load, and the
         ClientRouter swaps the DOM on each view transition). -->
    <script>
      function initTocSpy() {
        const toc = document.querySelector("nav.toc");
        const content = document.querySelector("article.markdown");
        if (!toc || !content) return;

        const links = new Map<string, HTMLAnchorElement>();
        toc.querySelectorAll<HTMLAnchorElement>("a.toc-link").forEach((a) => {
          const id = decodeURIComponent(a.hash.slice(1));
          if (id) links.set(id, a);
        });
        if (links.size === 0) return;

        const headings = Array.from(
          content.querySelectorAll<HTMLElement>("h2[id], h3[id]"),
        ).filter((h) => links.has(h.id));
        if (headings.length === 0) return;

        let activeId = "";
        function setActive(id: string) {
          if (id === activeId) return;
          const prev = links.get(activeId);
          if (prev) prev.classList.remove("toc-active");
          const next = links.get(id);
          if (next) next.classList.add("toc-active");
          activeId = id;
        }

        const visible = new Set<string>();
        const observer = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) visible.add(e.target.id);
              else visible.delete(e.target.id);
            }
            // Pick the first heading (document order) currently visible.
            const current = headings.find((h) => visible.has(h.id));
            if (current) {
              setActive(current.id);
            } else {
              // Nothing intersecting (between sections) — keep the last heading
              // above the viewport top as active.
              let above = headings[0];
              for (const h of headings) {
                if (h.getBoundingClientRect().top < 120) above = h;
                else break;
              }
              setActive(above.id);
            }
          },
          { rootMargin: "-100px 0px -70% 0px", threshold: 0 },
        );
        headings.forEach((h) => observer.observe(h));

        // Clean up when the ClientRouter navigates away from this page.
        document.addEventListener(
          "astro:before-swap",
          () => observer.disconnect(),
          { once: true },
        );
      }

      document.addEventListener("astro:page-load", initTocSpy);
    </script>

    <!-- Ratatoskr chatbot widget (served by the sqrlnest-chatbot Worker).
         One immutable line: the widget owns its own lifecycle, mounts a Shadow
         DOM on document.body (outside the ClientRouter swap region), and reads
         the active theme from localStorage (sqrlnest-theme / sqrlnest-mode) at
         runtime. `async` so it never blocks rendering; it loads after landing. -->
    <script is:inline type="module" src="/api/chatbot/chatbot.js" async></script>
  </body>
</html>
